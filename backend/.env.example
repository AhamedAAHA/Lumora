# Internal API port (not opened in browser — Vite proxies via 5173)
PORT=5000
SERVER_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/lumora
# Alias (either works): MONGO_URI=mongodb://127.0.0.1:27017/lumora
JWT_SECRET=replace_with_a_long_random_secret
# Required for AI questions, voice transcription (Whisper), and TTS fallback.
# Get a key: https://platform.openai.com/api-keys
# Local: set here in backend/.env — restart npm run dev after changing.
# Production (Render/Railway/etc.): add OPENAI_API_KEY in the hosting dashboard env vars.
OPENAI_API_KEY=sk-your-openai-key

# --- ElevenLabs (AI interviewer voice) ---
# 1. Sign up: https://elevenlabs.io
# 2. Profile → API Keys → Create key
# 3. Voice Library → pick voices → copy each Voice ID
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# One voice ID per interviewer personality (from ElevenLabs Voice Library)
VOICE_FRIENDLY_HR=21m00Tcm4TlvDq8ikWAM
VOICE_STRICT_CORPORATE=AZnzlk1XvdvUeBnXmlld
VOICE_SENIOR_ENGINEER=ErXwobaYiN019PkySvjV
VOICE_STARTUP_FOUNDER=MF3mGyEYCl7XYWbV9V6O
VOICE_TECHNICAL_LEAD=pNInz6obpgDQGcFmaJgB

CLIENT_URL=http://localhost:5173
# App URL — use only http://localhost:5173 in the browser

# Admin bootstrap credentials (run: node scripts/seedAdmin.js)
# Keep real deployment values only in local or hosting environment variables.
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=replace_with_a_long_unique_password

# Optional local demo candidate credential (required only for npm run seed:demo)
DEMO_CANDIDATE_PASSWORD=replace_with_a_local_demo_password

# Primary ElevenLabs interviewer voice (overrides personality map when set)
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
